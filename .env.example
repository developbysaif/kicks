# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/kickhomecare
MONGODB_DB_NAME=kickhomecare

# Application URL (used for email verification links)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Provider Configuration (Option A: Resend API)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Kicks Home Care <noreply@kickhomecare.com>

# Email Provider Configuration (Option B: SMTP / Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Admin Credentials
ADMIN_EMAIL=admin@kickhomecare.com
ADMIN_PASSWORD=admin123
ADMIN_NOTIFY_EMAIL=admin@kickhomecare.com

# JWT & Authentication Secret
AUTH_SECRET=super_secret_auth_key_change_in_production

# Upstash Redis Rate Limiting (Optional, in-memory fallback included)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (Optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
