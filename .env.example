# Database Configuration (Production: MongoDB Atlas, Local: mongodb://127.0.0.1:27017/kickhomecare)
MONGODB_URI=mongodb://127.0.0.1:27017/kickhomecare
MONGODB_DB_NAME=kickhomecare

# Application URL
APP_URL=https://kicks-beta-three.vercel.app
NEXT_PUBLIC_SITE_URL=https://kicks-beta-three.vercel.app

# Transactional Email Provider (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Kicks <onboarding@resend.dev>

# Optional SMTP Provider (Secondary Fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Admin Credentials
ADMIN_EMAIL=admin@kickhomecare.com
ADMIN_PASSWORD=admin123
ADMIN_NOTIFY_EMAIL=admin@kickhomecare.com

# JWT & Authentication Secret
AUTH_SECRET=super_secret_auth_key_change_in_production
JWT_SECRET=super_secret_auth_key_change_in_production

# Upstash Redis Rate Limiting (Optional - in-memory fallback enabled by default)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
